    "cron:daily-insight": "npm run cron -- daily_insight",
    "cron:recommendation-expiry": "npm run cron -- recommendation_expiry",
    "check:schema": "node --env-file=.env.local scripts/check-schema-drift.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.22",
    "@ai-sdk/openai": "^4.0.16",
    "@supabase/supabase-js": "^2.110.7",
    "ai": "^7.0.31",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "next": "15.5.20",
    "next-auth": "^4.24.14",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "unpdf": "^1.6.2",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "pg": "^8.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.10"
