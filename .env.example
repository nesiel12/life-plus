# Life Plus's chat/text-generation AI providers. Gemini is primary — set
# GEMINI_API_KEY (get one at https://aistudio.google.com/apikey) and it is
# used whenever present. OPENAI_API_KEY is the final fallback in the chain
# (see lib/ai/provider.ts's getChatModelChain) and is also required for
# audio transcription (Torah Space uploads), which is Whisper-specific
# regardless of which provider handles chat. BYTEZ_API_KEY is optional — a
# middle fallback tier between Gemini and OpenAI (get one at
# https://bytez.com); every key here is optional on its own, but at least
# one of GEMINI_API_KEY/OPENAI_API_KEY must be set for any AI feature to work.
OPENAI_API_KEY=
GEMINI_API_KEY=
BYTEZ_API_KEY=

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
# The app's public origin, no trailing slash. Every Google OAuth redirect URI
# (sign-in AND Google Photos) is derived from this and must match what's
# registered in the Google Cloud console — a mismatch is the
# `redirect_uri_mismatch` 400. In production set this to the real domain and
# redeploy. See docs/GOOGLE_OAUTH_SETUP.md.
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase (see docs/ROADMAP_V2.md Phase 1) — server-only, never expose the service
# role key to the client.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Proactive Engine — shared secret guarding /api/cron/[job]. Generate with:
# openssl rand -base64 32. Vercel Cron injects `Authorization: Bearer
# $CRON_SECRET` automatically when an env var of exactly this name exists, so
# setting it in Vercel's project settings is all the wiring the deployed cron
# needs. The GitHub Actions fallback sweep (.github/workflows/proactive-sweep.yml)
# needs the same value as a repository secret. See docs/PROACTIVE_ENGINE.md.
CRON_SECRET=

# Outbound email for proactive notifications (Resend — https://resend.com).
# Without these the app still runs and still produces in-app notifications;
# it simply sends no mail, and jobs report success rather than retrying
# forever (lib/notify/channels/email.ts).
#
# RESEND_API_KEY: from the Resend dashboard.
# EMAIL_FROM: a sender on a domain verified in Resend, e.g.
#   "Life Plus <noreply@your-domain.com>". Until a domain is verified, Resend
#   only delivers to the account owner's own address — which is enough to test.
# EMAIL_APP_URL: absolute base URL used for links inside emails (deep links
#   and the one-click unsubscribe). Falls back to NEXTAUTH_URL when unset, so
#   it only needs setting when the public URL differs from the auth URL.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_APP_URL=

# Free AI quota, enforced per authenticated user in the database
# (supabase/migrations/20260906020000_ai_usage_quota.sql). All optional —
# each falls back to the default in lib/ai/quota.ts if unset or malformed.
#
# Requests are weighted by cost, not counted flat: a course module is 3 units
# because it emits several times a chat turn's output. Transcription has its
# own budget in audio minutes, because Whisper is priced per minute and one
# call can cost far more than a day of chat.
FREE_AI_REQUESTS_PER_DAY=40
FREE_AI_TRANSCRIPTION_MINUTES_PER_DAY=10
# Burst guard, so a day's allowance cannot be drained in one second.
FREE_AI_REQUESTS_PER_MINUTE=6

