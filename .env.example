# Life Plus's chat/text-generation AI providers. Gemini is primary — set
# GEMINI_API_KEY (get one at https://aistudio.google.com/apikey) and it is
# used whenever present. OPENAI_API_KEY is the final fallback in the chain
# (see lib/ai/provider.ts's getChatModelChain) and is also required for
# audio transcription (Torah Space uploads), which is Whisper-specific
# regardless of which provider handles chat. BYTEZ_API_KEY is optional — a
# middle fallback tier between Gemini and OpenAI (get one at
# https://bytez.com); every key here is optional on its own, but at least
# one of GEMINI_API_KEY/OPENAI_API_KEY must be set for any AI feature to work.
OPENAI_API_KEY=
GEMINI_API_KEY=
BYTEZ_API_KEY=

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase (see docs/ROADMAP_V2.md Phase 1) — server-only, never expose the service
# role key to the client.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Proactive Engine (M2) — shared secret guarding POST /api/cron/[job]. Generate
# with: openssl rand -base64 32. Set the same value in the scheduler (Vercel Cron
# headers, or Supabase pg_cron). See docs/PROACTIVE_ENGINE.md.
CRON_SECRET=

# Free AI quota, enforced per authenticated user in the database
# (supabase/migrations/20260906020000_ai_usage_quota.sql). All optional —
# each falls back to the default in lib/ai/quota.ts if unset or malformed.
#
# Requests are weighted by cost, not counted flat: a course module is 3 units
# because it emits several times a chat turn's output. Transcription has its
# own budget in audio minutes, because Whisper is priced per minute and one
# call can cost far more than a day of chat.
FREE_AI_REQUESTS_PER_DAY=40
FREE_AI_TRANSCRIPTION_MINUTES_PER_DAY=10
# Burst guard, so a day's allowance cannot be drained in one second.
FREE_AI_REQUESTS_PER_MINUTE=6

