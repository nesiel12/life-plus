# Life Plus's chat/text-generation AI provider — OpenAI and/or Gemini. If both
# are set, OpenAI is used. Leave OPENAI_API_KEY blank and set only
# GEMINI_API_KEY to run entirely on Gemini (get a key at
# https://aistudio.google.com/apikey). Note: audio transcription (Torah
# Space uploads) is Whisper/OpenAI-specific and needs OPENAI_API_KEY
# regardless of which provider handles chat.
OPENAI_API_KEY=
GEMINI_API_KEY=

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase (see docs/ROADMAP_V2.md Phase 1) — server-only, never expose the service
# role key to the client.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Proactive Engine (M2) — shared secret guarding POST /api/cron/[job]. Generate
# with: openssl rand -base64 32. Set the same value in the scheduler (Vercel Cron
# headers, or Supabase pg_cron). See docs/PROACTIVE_ENGINE.md.
CRON_SECRET=
